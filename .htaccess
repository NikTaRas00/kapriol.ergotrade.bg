# ============================================================================
# kapriol.bg — Apache config for SuperHosting.bg (cPanel)
# ============================================================================

Options -Indexes -MultiViews
# index.php FIRST, then index.html. The public pages are unaffected (the web
# root has no index.php, so index.html still serves "/"), but /admin/ must
# resolve to its dashboard index.php. A stale admin/index.html redirect stub
# was left behind by an earlier move and, with index.html winning, it shadowed
# the real dashboard and bounced /admin/ to a hardcoded absolute URL. Ordering
# index.php first makes that stub inert wherever it still exists.
DirectoryIndex index.php index.html

# -------------------------------------------------------------- Private data --
# Never serve admin secrets / logs, the shared guard include, or half-written
# temp files. (Best practice is to keep private/ OUTSIDE the web root entirely;
# these rules are belt-and-braces in case it lives under public_html.)
# NOTE: content.json is intentionally NOT blocked — the public site fetches it
# for the home/contact copy. It is only WRITABLE via the authed admin API.
# (products.json and attributes.json are no longer read by the site at all:
# the catalogue moved to MySQL and is served by api/*.php. Any leftover copies
# under assets/data/ are inert.)
<FilesMatch "(config|enquiries|login-throttle|analytics)\.(php|json)$">
  Require all denied
</FilesMatch>
# Shared includes are never entry points. Anchored on "_" at the start of the
# basename so this covers admin/api/_guard.php, api/_bootstrap.php and anything
# added later with the same convention.
<FilesMatch "(^_.*\.php|\.tmp)$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------- Redirects --
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forbid the private/ data folder outright if it ever sits inside the web root.
  RewriteRule ^private/ - [F,L]

  # www -> non-www, forcing HTTPS in the same hop.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Force HTTPS for the non-www host.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Dynamic sitemap: /sitemap.xml is generated by sitemap.php from the live
  # catalog (robots.txt points crawlers here).
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # ---------------------------------------------- Clean (extensionless) URLs --
  # Works at the web root AND inside a subfolder (e.g. /1/) because %{THE_REQUEST}
  # carries the full path the client actually asked for.
  #
  # 1) ".../index.html"  -> ".../"        (canonical home)
  RewriteCond %{THE_REQUEST} \s/+(([^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # 2) ".../page.html"    -> ".../page"   (strip .html everywhere else; query kept)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # 3) Internally serve "page" from "page.html" when that file exists.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 4) Intended to make /products/foo — a path segment hanging off a page that
  #    does not exist — 404 through our own ErrorDocument instead of Apache's
  #    RAW 500. DEPLOYED 2026-08-29 AND IT DID NOT WORK: those URLs still 500.
  #    The primary status is already 500 before any ErrorDocument is attempted,
  #    so the cause is upstream of this rule (see CLAUDE.md -> OPEN BUG; the
  #    Apache error log is the next step). Left in place because it is correct
  #    in itself and harmless — verified after deploy that every page, the
  #    clean URLs, /error/404 and the styled 403/404/500 pages still work.
  #    It MUST stay after rule 3, or extensionless URLs one level down
  #    (e.g. /error/404) would be caught before rule 3 can map them.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^[^/]+/.+ - [R=404,L]
</IfModule>

# ------------------------------------------------------------- Error pages --
# Styled, self-contained pages in error/. Paths are server-root-relative; the
# site lives at the kapriol.ergotrade.bg subdomain ROOT, so no prefix. If the
# site ever moves into a subfolder again, prefix these AND each error page's
# <base href>.
ErrorDocument 400 /error/400.html
ErrorDocument 401 /error/401.html
ErrorDocument 403 /error/403.html
ErrorDocument 404 /error/404.html
ErrorDocument 405 /error/405.html
ErrorDocument 429 /error/429.html
ErrorDocument 500 /error/500.html
ErrorDocument 502 /error/502.html
ErrorDocument 503 /error/503.html
ErrorDocument 504 /error/504.html

# ------------------------------------------------------------ Compression --
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# --------------------------------------------------------------- Caching ----
# One year for static assets (css/js/img/video). HTML stays short so updates show.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Belt-and-braces Cache-Control for the asset directories.
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Admin-editable data must always revalidate so edits show immediately —
  # never let the browser heuristically cache it. content.json is the only
  # such file left; the catalogue endpoints under api/ send the same
  # Cache-Control header themselves (see api/_bootstrap.php).
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# ----------------------------------------------------------- Mime fallback --
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
