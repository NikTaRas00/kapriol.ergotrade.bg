# ============================================================================
# kapriol.bg — Apache config for SuperHosting.bg (cPanel)
# ============================================================================

Options -Indexes -MultiViews
# index.html first (the public pages), then index.php so directories that are
# PHP-only still resolve — notably /admin/, whose dashboard is index.php.
DirectoryIndex index.html index.php

# -------------------------------------------------------------- Private data --
# Never serve admin secrets / logs, the shared guard include, or half-written
# temp files. (Best practice is to keep private/ OUTSIDE the web root entirely;
# these rules are belt-and-braces in case it lives under public_html.)
# NOTE: products.json and content.json are intentionally NOT blocked — the
# public site fetches them. They are only WRITABLE via the authed admin API.
<FilesMatch "(config|enquiries|login-throttle|analytics)\.(php|json)$">
  Require all denied
</FilesMatch>
<FilesMatch "(_guard\.php|\.tmp)$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------- Redirects --
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forbid the private/ data folder outright if it ever sits inside the web root.
  RewriteRule ^private/ - [F,L]

  # www -> non-www, forcing HTTPS in the same hop.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Force HTTPS for the non-www host.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Dynamic sitemap: /sitemap.xml is generated by sitemap.php from the live
  # catalog (robots.txt points crawlers here).
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # ---------------------------------------------- Clean (extensionless) URLs --
  # Works at the web root AND inside a subfolder (e.g. /1/) because %{THE_REQUEST}
  # carries the full path the client actually asked for.
  #
  # 1) ".../index.html"  -> ".../"        (canonical home)
  RewriteCond %{THE_REQUEST} \s/+(([^\s?]*/)?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # 2) ".../page.html"    -> ".../page"   (strip .html everywhere else; query kept)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  # 3) Internally serve "page" from "page.html" when that file exists.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------- Error pages --
# Styled, self-contained pages in error/. Paths are server-root-relative; the
# site lives at the kapriol.ergotrade.bg subdomain ROOT, so no prefix. If the
# site ever moves into a subfolder again, prefix these AND each error page's
# <base href>.
ErrorDocument 400 /error/400.html
ErrorDocument 401 /error/401.html
ErrorDocument 403 /error/403.html
ErrorDocument 404 /error/404.html
ErrorDocument 405 /error/405.html
ErrorDocument 429 /error/429.html
ErrorDocument 500 /error/500.html
ErrorDocument 502 /error/502.html
ErrorDocument 503 /error/503.html
ErrorDocument 504 /error/504.html

# ------------------------------------------------------------ Compression --
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# --------------------------------------------------------------- Caching ----
# One year for static assets (css/js/img/video). HTML stays short so updates show.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Belt-and-braces Cache-Control for the asset directories.
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Admin-editable data (products/content/attributes) must always revalidate so
  # edits show immediately — never let the browser heuristically cache them.
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# ----------------------------------------------------------- Mime fallback --
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
